{
	"extends": [
		"@tsconfig/strictest/tsconfig.json",
		"@tsconfig/next/tsconfig.json"
	],
	"compilerOptions": {
		"target": "ESNext",
		"paths": {
			"@/*": ["./src/*"],
			"@public/*": ["./public/*"]
		},
		"exactOptionalPropertyTypes": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"include": [
		"global.d.ts",
		"next-env.d.ts",
		"./src/**/*.ts",
		"./src/**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
